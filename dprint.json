{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "incremental": true,
  "indentWidth": 4,
  "lineWidth": 80,
  "useTabs": true,
  "newLineKind": "lf",
  "typescript": {
    "semiColons": "prefer",
    "quoteStyle": "preferSingle",
    "quoteProps": "preserve",
    "trailingCommas": "never",
    "operatorPosition": "maintain",
    "useBraces": "maintain",
    "arrowFunction.useParentheses": "force",
    "functionExpression.spaceAfterFunctionKeyword": true,
    "module.sortImportDeclarations": "caseInsensitive",
    "module.sortExportDeclarations": "caseInsensitive",
    "importDeclaration.sortNamedImports": "caseInsensitive",
    "importDeclaration.sortTypeOnlyImports": "last",
    "exportDeclaration.sortNamedExports": "caseInsensitive",
    "exportDeclaration.sortTypeOnlyExports": "last"
  },
  "json": {
    "indentWidth": 2,
    "useTabs": false,
    "packageJson.applyConventions": false
  },
  "includes": [
    "**/*.{ts,tsx,js,jsx,cjs,mjs,cts,mts,json,jsonc,yaml,yml,toml}"
  ],
  "excludes": [
    "**/node_modules/**",
    "**/dist/**",
    "**/*.tsbuildinfo",
    "**/*.md",
    "bun.lock"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.96.1.wasm",
    "https://plugins.dprint.dev/json-0.25.2.wasm",
    "https://plugins.dprint.dev/toml-0.9.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
  ]
}
