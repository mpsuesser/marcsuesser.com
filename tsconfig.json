{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "extends": "./tsconfig.base.json",
  "include": [
    "alchemy.run.ts",
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "**/dist/**"],
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  }
}
